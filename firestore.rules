rules_version = '2';

// FoodGenome AI — Firestore security rules.
//
// Every client operation is denied. That is not an oversight and it is not a
// placeholder: no browser in this system ever talks to Firestore. The web app's
// only use of Firebase is Authentication — it signs a user in and hands the ID
// token to our own FastAPI service, which verifies it against Google's public
// keys and does the reading and writing itself through the Admin SDK.
//
// The Admin SDK bypasses these rules by design, so denying everything here
// costs the service nothing and removes a whole class of mistake. There is no
// rule to get subtly wrong, no query a determined visitor can widen, and no way
// to enumerate one account's predictions by guessing at another's uid — the
// only path to a row is /history, which is scoped server-side to the caller's
// own token, or /analytics, which is checked against the operator list.
//
// If a future version does want direct client reads — a live prediction feed
// over onSnapshot is the obvious candidate — the rule for it belongs here and
// must be written per collection, scoped to `request.auth.uid`, never opened
// wholesale. Deploy with:
//
//     firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
