# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NOTHING IN THIS FILE SHOULD EVER BE PASTED INTO A CHAT, ISSUE OR COMMIT.
# The Firebase *web* config (NEXT_PUBLIC_*) is public by design and ships in the
# browser bundle. The service account key is the opposite: it bypasses every
# Firebase Security Rule and grants full admin access to the project.

# ---------------------------------------------------------------------------
# Firebase Admin (server-side only, used by the FastAPI backend)
# ---------------------------------------------------------------------------
# Point this at the downloaded service-account JSON. Keep the file OUTSIDE the
# repository - e.g. ~/.config/foodgenome/service-account.json - so it cannot be
# committed by accident.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/repo/service-account.json

# On Hugging Face Spaces there is no filesystem to point at, so paste the JSON
# as a Space secret named FIREBASE_SERVICE_ACCOUNT_JSON instead and leave
# GOOGLE_APPLICATION_CREDENTIALS unset. The backend accepts either.
# FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=foodgenome-ai
FIREBASE_STORAGE_BUCKET=foodgenome-ai.firebasestorage.app

# ---------------------------------------------------------------------------
# Firebase web config (public - safe in the client bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=foodgenome-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=foodgenome-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=foodgenome-ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# OpenAI (server-side only - real money, see prompt.md 3.2 for cost controls)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
# Hard daily ceiling. When exceeded the RAG pipeline degrades to deterministic
# template answers rather than erroring, so the app stays up at zero cost.
OPENAI_DAILY_BUDGET_USD=1.00

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Cohere (hosted reranker for the RAG retrieval stage)
# ---------------------------------------------------------------------------
COHERE_API_KEY=
# cohere | cross-encoder. cross-encoder runs locally, needs no key and no network,
# and is what the published retrieval numbers were measured on.
RAG_RERANKER=cross-encoder
# A Cohere trial key allows ten calls a minute; calls are paced to stay under it.
COHERE_REQUESTS_PER_MINUTE=10
